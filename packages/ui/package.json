{
  "name": "qrlayout-ui",
  "version": "1.1.5",
  "description": "Embeddable drag-and-drop QR label designer — works in React, Vue, Svelte, Angular and vanilla JS. Pairs with qrlayout-core.",
  "keywords": [
    "qr-code",
    "qr-layout",
    "qr-layout-designer",
    "qr-label",
    "react",
    "vue",
    "svelte",
    "angular",
    "react-qrcode",
    "vue-qrcode",
    "svelte-qrcode",
    "angular-qrcode",
    "drag-and-drop",
    "drag-drop",
    "ui-component",
    "low-code",
    "visual-editor",
    "label-designer",
    "label-printing",
    "badge-designer",
    "shipping-label",
    "sticker-designer",
    "sticker-printing",
    "undo-redo",
    "snap-to-grid",
    "typescript",
    "framework-agnostic",
    "embeddable",
    "zpl",
    "zebra-printer",
    "thermal-printer",
    "pdf-export",
    "png-export",
    "barcode",
    "barcode-generator",
    "label-maker"
  ],
  "author": "Mithun Dev",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/qrlayout-ui.umd.js",
  "module": "./dist/qrlayout-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/qrlayout-ui.js",
      "require": "./dist/qrlayout-ui.umd.js"
    },
    "./style.css": "./dist/qrlayout-ui.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:app": "vite build --config vite.app.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "qrlayout-core": ">=1.1.10"
  },
  "peerDependencies": {
    "qrlayout-core": ">=1.1.10"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4"
  }
}
